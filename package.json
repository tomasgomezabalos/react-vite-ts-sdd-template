{
  "name": "react-vite-ts-sdd-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mocks": "vite --mode mock",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run --exclude \"tests/tools/**\"",
    "test:coverage": "vitest run --coverage --exclude \"tests/tools/**\"",
    "test:tools": "vitest run tests/tools",
    "test:watch": "vitest --exclude \"tests/tools/**\"",
    "docs:check": "node tools/quality/docs-check.ts",
    "architecture:check": "node tools/quality/architecture-check.ts",
    "check": "npm run lint && npm run docs:check && npm run architecture:check && npm run test:coverage && npm run build",
    "preview": "vite preview",
    "template:init": "node tools/template/init.ts",
    "template:doctor": "node tools/template/doctor.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,scss,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,scss,json}\""
  },
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.23.2 <23",
    "npm": ">=10.9.8 <11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.2",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "10.9.8",
      "onFail": "error"
    }
  },
  "dependencies": {
    "i18next": "^26.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.9",
    "sass": "^1.103.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "mocks/public"
    ]
  }
}
